# ====== Rede ======
# IP do PC na rede Wi-Fi/LAN. O app só fica acessível por essa interface.
# Dica: reserve esse IP no roteador (DHCP reservation) para ele não mudar.
BIND_IP=192.168.0.4
PORT=8000

# ====== Google Drive ======
# ID da pasta (o trecho final da URL: drive.google.com/drive/folders/<ID>).
# Se vazio, procura uma pasta com o nome abaixo compartilhada com a service account.
DRIVE_FOLDER_ID=
DRIVE_FOLDER_NAME=Animes

# Minutos de cache da listagem = LIBRARY_TTL_SECONDS / 60 (economiza chamadas à API)
LIBRARY_TTL_SECONDS=1800

# ====== FFmpeg (modo compatível) ======
CPU_LIMIT=4
MAX_TRANSCODES=2
MAX_SUBTITLE_JOBS=2
TRANSCODE_PRESET=veryfast
TRANSCODE_CRF=23
TRANSCODE_MAX_HEIGHT=1080

LOG_LEVEL=info
ENABLE_DOCS=false
